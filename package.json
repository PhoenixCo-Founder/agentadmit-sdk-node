{
  "name": "@agentadmit/sdk",
  "version": "1.0.0",
  "description": "AgentAdmit SDK \u2014 User-mediated AI agent authorization for Node.js apps",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest"
  },
  "dependencies": {
    "jsonwebtoken": "9.0.0",
    "js-yaml": "4.1.0",
    "uuid": "9.0.0",
    "mongodb": "6.0.0"
  },
  "devDependencies": {
    "typescript": "5.3.0",
    "@types/node": "20.0.0",
    "@types/jsonwebtoken": "9.0.0",
    "@types/js-yaml": "4.0.0",
    "@types/uuid": "9.0.0",
    "@types/express": "4.17.0",
    "jest": "29.0.0",
    "@types/jest": "29.0.0",
    "ts-jest": "29.0.0"
  },
  "peerDependencies": {
    "express": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
